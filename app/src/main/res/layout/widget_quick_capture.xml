<?xml version="1.0" encoding="utf-8"?>
<!-- One wide (4x2) widget: four medium rounded-square tiles in a row,
     icons only, no text — "Home" (opens the app's home screen), "Catch
     a quick idea", "Record a melody" and "Write a song". The squares
     are a fixed medium size centred in the widget, not stretched to
     its full height. Colours mirror the app's dark "Analog Midnight
     Studio" theme (StudioSurface / StudioSurfaceHigh / StudioInk);
     each tile's icon uses its accent colour (sky / amber / coral /
     mint). Labels survive only as content descriptions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/widget_tile_home"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/widget_tile_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_icon_home"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@string/widget_tile_home" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_tile_idea"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/widget_tile_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_icon_idea"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@string/widget_tile_idea" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_tile_record"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/widget_tile_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_icon_record"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@string/widget_tile_record" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_tile_song"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/widget_tile_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_icon_song"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@string/widget_tile_song" />
    </LinearLayout>
</LinearLayout>
