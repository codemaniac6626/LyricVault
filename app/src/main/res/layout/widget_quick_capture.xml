<?xml version="1.0" encoding="utf-8"?>
<!-- One wide (4x2) widget with three equal tiles in a row. Colours mirror
     the app's dark "Analog Midnight Studio" theme (StudioSurface /
     StudioSurfaceHigh / StudioInk) so the widget sits naturally next to the
     app icon; each tile's icon uses its accent colour (amber / coral /
     mint). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/widget_tile_idea"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="6dp"
        android:background="@drawable/widget_tile_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/widget_tile_idea"
            android:src="@drawable/ic_widget_idea" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/widget_tile_idea"
            android:textColor="#F2F0EA"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_tile_record"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="6dp"
        android:background="@drawable/widget_tile_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/widget_tile_record"
            android:src="@drawable/ic_widget_mic" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/widget_tile_record"
            android:textColor="#F2F0EA"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_tile_song"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        
        android:background="@drawable/widget_tile_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/widget_tile_song"
            android:src="@drawable/ic_widget_song" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/widget_tile_song"
            android:textColor="#F2F0EA"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
