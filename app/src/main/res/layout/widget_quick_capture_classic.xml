<?xml version="1.0" encoding="utf-8"?>
<!-- The classic 4x2 quick-capture widget (the original three-button
     style, kept as a second variant alongside the icons-only widget):
     "Catch a quick idea", "Record a melody" and "Write a song" as
     three full-height tiles with icon over label. Colours mirror the
     app's dark "Analog Midnight Studio" theme (StudioSurface /
     StudioSurfaceHigh / StudioInk); each tile's icon uses its accent
     colour (amber / coral / mint). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/widget_tile_idea_classic"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:background="@drawable/widget_tile_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_icon_idea_classic"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/widget_tile_idea" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/widget_tile_idea"
            android:textColor="#E8EAF0"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_tile_record_classic"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:background="@drawable/widget_tile_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_icon_record_classic"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/widget_tile_record" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/widget_tile_record"
            android:textColor="#E8EAF0"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_tile_song_classic"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_tile_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_icon_song_classic"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/widget_tile_song" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/widget_tile_song"
            android:textColor="#E8EAF0"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
